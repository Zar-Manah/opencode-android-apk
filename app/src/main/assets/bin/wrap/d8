#!/system/bin/sh
# d8: standalone dynamic-home & RAM-aware Android D8 dexer wrapper.
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -d "$SELF_DIR/../toolchain/usr" ]; then
  export HOME=$(cd "$SELF_DIR/.." && pwd)
elif [ -d "$SELF_DIR/../usr" ]; then
  export HOME=$(cd "$SELF_DIR/../.." && pwd)
elif [ -d "$SELF_DIR/../../../toolchain/usr" ]; then
  export HOME=$(cd "$SELF_DIR/../../.." && pwd)
elif [ -z "${HOME:-}" ] || [ ! -d "$HOME/toolchain/usr" ]; then
  export HOME="/data/user/0/a.opencode/files/server-home"
fi
XMX="${OPENCODE_D8_XMX:-}"
if [ -z "$XMX" ] && [ -r /proc/meminfo ]; then
  KB=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
  MB=$(( ${KB:-4096000} / 1024 ))
  if [ "$MB" -ge 10000 ]; then XMX="-Xmx2048m"
  elif [ "$MB" -ge 7000 ]; then XMX="-Xmx1536m"
  elif [ "$MB" -ge 5000 ]; then XMX="-Xmx1024m"
  else XMX="-Xmx768m"
  fi
fi
XMX="${XMX:--Xmx1024m}"
mkdir -p "$HOME/tmp" 2>/dev/null
JAVA_BIN="$HOME/toolchain/bin/java"
[ -x "$JAVA_BIN" ] || JAVA_BIN="$HOME/toolchain/usr/lib/jvm/java-21-openjdk/bin/java"
JAR="$HOME/android-sdk/build-tools/35.0.0/lib/d8.jar"
[ -f "$JAR" ] || JAR="$HOME/android-sdk/build-tools/34.0.0/lib/d8.jar"
exec "$JAVA_BIN" -Djava.io.tmpdir="$HOME/tmp" "$XMX" -cp "$JAR" com.android.tools.r8.D8 "$@"
