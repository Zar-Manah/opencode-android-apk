#!/system/bin/sh
# open-factory-setup: autonomous on-device toolchain verifier & setup.
set -u
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -d "$SELF_DIR/../toolchain/usr" ]; then
  H=$(cd "$SELF_DIR/.." && pwd)
elif [ -n "${HOME:-}" ] && [ -d "$HOME/toolchain/usr" ]; then
  H="$HOME"
else
  H="/data/user/0/a.opencode/files/server-home"
fi
export HOME="$H"
TC="$H/toolchain"
SDK="$H/android-sdk"
mkdir -p "$H/tmp" "$H/bin" "$TC/bin" "$H/.android" 2>/dev/null

echo "== 1/4 Base toolchain =="
if [ ! -x "$TC/usr/lib/jvm/java-21-openjdk/bin/java" ] && [ ! -x "$TC/usr/lib/jvm/java-21-openjdk/bin/java.real" ]; then
  mkdir -p "$TC"
  if [ -f "$H/toolchain-native.tar" ]; then
    tar -xf "$H/toolchain-native.tar" -C "$TC" || { echo "ERROR extracting toolchain"; exit 1; }
  else
    echo "ERROR: toolchain not extracted yet"
    exit 1
  fi
else
  echo "Toolchain present"
fi

wrap_binary() {
  bin_file="$1"
  real_file="${bin_file}.real"
  jhome="${2:-}"
  lib_rel="${3:-usr/lib}"
  if [ -f "$bin_file" ] && [ ! -f "$real_file" ]; then
    mv "$bin_file" "$real_file"
    chmod 755 "$real_file" 2>/dev/null
    {
      echo '#!/system/bin/sh'
      echo 'export HOME="'"$H"'"'
      if [ -n "$jhome" ]; then
        echo 'export JAVA_HOME="'"$jhome"'"'
      fi
      if [ "$lib_rel" = "usr/lib/adb-libs" ]; then
        echo 'export ANDROID_USER_HOME="'"$H"'/.android"'
        echo 'export TMPDIR="'"$H"'/tmp"'
        echo 'export ANDROID_ADB_SERVER_PORT="${ANDROID_ADB_SERVER_PORT:-15037}"'
      fi
      echo 'LD_LIBRARY_PATH="'"$TC/$lib_rel"'" exec "'"$real_file"'" "$@"'
    } > "$bin_file"
    chmod 755 "$bin_file" 2>/dev/null
  fi
}

wrap_binary "$TC/usr/bin/git" "" "usr/lib"
wrap_binary "$TC/usr/bin/aapt2" "" "usr/lib"
wrap_binary "$TC/usr/bin/adb" "" "usr/lib/adb-libs"

JDK_BIN="$TC/usr/lib/jvm/java-21-openjdk/bin"
for b in java javac keytool jar; do
  wrap_binary "$JDK_BIN/$b" "$TC/usr/lib/jvm/java-21-openjdk" "usr/lib"
done

EXT_WORK="${EXTERNAL_STORAGE:-/storage/emulated/0}/OpenCode"
if [ -d "$EXT_WORK" ] || mkdir -p "$EXT_WORK" 2>/dev/null; then
  ln -sfn "$EXT_WORK" "$H/OpenCode" 2>/dev/null
fi

echo "== 2/4 Command-line tools and SDK =="
for w in java javac keytool git aapt2 d8 apksigner adb; do
  if [ -f "$H/bin/wrap/$w" ]; then
    cp "$H/bin/wrap/$w" "$H/bin/$w" 2>/dev/null
    chmod 755 "$H/bin/$w" 2>/dev/null
    cp "$H/bin/wrap/$w" "$TC/bin/$w" 2>/dev/null
    chmod 755 "$TC/bin/$w" 2>/dev/null
  fi
done

if [ -f "$H/bin/gradle-oc" ]; then
  cp "$H/bin/gradle-oc" "$TC/bin/gradle-oc" 2>/dev/null
  chmod 755 "$TC/bin/gradle-oc" 2>/dev/null
fi

for ver in 35.0.0 34.0.0; do
  BDIR="$SDK/build-tools/$ver"
  if [ -d "$BDIR" ]; then
    cp "$H/bin/wrap/d8" "$BDIR/d8" 2>/dev/null && chmod 755 "$BDIR/d8" 2>/dev/null
    cp "$H/bin/wrap/apksigner" "$BDIR/apksigner" 2>/dev/null && chmod 755 "$BDIR/apksigner" 2>/dev/null
    cp "$H/bin/wrap/aapt2" "$BDIR/aapt2" 2>/dev/null && chmod 755 "$BDIR/aapt2" 2>/dev/null
  fi
done

echo "== 3/4 Environment configuration =="
XMX="-Xmx1536m"
if [ -r /proc/meminfo ]; then
  KB=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
  MB=$(( ${KB:-4096000} / 1024 ))
  if [ "$MB" -ge 10000 ]; then XMX="-Xmx3072m"
  elif [ "$MB" -ge 7000 ]; then XMX="-Xmx2048m"
  elif [ "$MB" -ge 5000 ]; then XMX="-Xmx1536m"
  else XMX="-Xmx1024m"
  fi
fi

mkdir -p "$H/.gradle" "$H/.android" 2>/dev/null
GP="$H/.gradle/gradle.properties"
touch "$GP"
grep -q aapt2FromMavenOverride "$GP" 2>/dev/null || echo "android.aapt2FromMavenOverride=$TC/bin/aapt2" >> "$GP"
grep -q suppressAgpWarnings "$GP" 2>/dev/null || echo "android.sync.suppressAgpWarnings=UNSUPPORTED_PROJECT_OPTION_USE" >> "$GP"
grep -q suppressUnsupportedCompileSdk "$GP" 2>/dev/null || echo "android.suppressUnsupportedCompileSdk=35" >> "$GP"
grep -q org.gradle.jvmargs "$GP" 2>/dev/null || echo "org.gradle.jvmargs=$XMX" >> "$GP"

MKSHRC="$H/.mkshrc"
{
  echo 'export HOME="'"$H"'"'
  echo 'export ANDROID_HOME="'"$H"'/android-sdk"'
  echo 'export ANDROID_SDK_ROOT="'"$H"'/android-sdk"'
  echo 'export JAVA_HOME="'"$TC"'/usr/lib/jvm/java-21-openjdk"'
  echo 'export ANDROID_USER_HOME="'"$H"'/.android"'
  echo 'export GRADLE_USER_HOME="'"$H"'/.gradle"'
  echo 'export ANDROID_ADB_SERVER_PORT="15037"'
  echo 'export PATH="'"$H"'/bin:'"$TC"'/bin:'"$TC"'/usr/bin:'"$H"'/android-sdk/platform-tools:'"$H"'/android-sdk/build-tools/35.0.0:'"$H"'/android-sdk/build-tools/34.0.0:/system/bin:${PATH:-}"'
  echo 'alias gradle="gradle-oc"'
} > "$MKSHRC"
cp "$MKSHRC" "$H/.profile" 2>/dev/null
cp "$MKSHRC" "$H/.bashrc" 2>/dev/null

echo "== 4/4 Toolchain verification =="
"$H/bin/java" -version 2>&1 | head -1
"$H/bin/git" --version 2>&1 | head -1
"$H/bin/aapt2" version 2>&1 | head -1
"$H/bin/adb" version 2>&1 | head -1
ls "$SDK/platforms/android-35/android.jar" >/dev/null 2>&1 && echo "platform-35 OK" || echo "FAIL platform-35"
ls "$SDK/build-tools/35.0.0/lib/d8.jar" >/dev/null 2>&1 && echo "build-tools-35 OK" || echo "FAIL build-tools-35"
echo "Toolchain and SDK verified ($XMX)"
