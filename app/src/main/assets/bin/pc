#!/system/bin/sh
# pc: authenticated device control CLI using bundled Bun/fetch runtime (zero curl dependency).
unset LD_LIBRARY_PATH
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -d "$SELF_DIR/../toolchain/usr" ]; then
  H=$(cd "$SELF_DIR/.." && pwd)
elif [ -n "${HOME:-}" ] && [ -d "$HOME/toolchain/usr" ]; then
  H="$HOME"
else
  H="/data/user/0/a.opencode/files/server-home"
fi

APP_FILES=$(cd "$H/.." && pwd)
S="$APP_FILES/server"

TOK="${OPENCODE_BRIDGE_TOKEN:-}"
if [ -z "$TOK" ] && [ -f "$H/.bridge-token" ]; then
  TOK=$(cat "$H/.bridge-token" 2>/dev/null)
fi

CMD="${1:-}"
A1="${2:-}"
A2="${3:-}"
A3="${4:-}"
A4="${5:-}"
A5="${6:-}"

# Resolve relative APK path for install before passing to bridge server process
if [ "$CMD" = "install" ] && [ -n "$A1" ]; then
  case "$A1" in
    /*) ;;
    *)
      D=$(dirname "$A1")
      B=$(basename "$A1")
      if [ -d "$D" ]; then
        A1=$(cd "$D" && pwd)/"$B"
      else
        A1="$PWD/$A1"
      fi
      ;;
  esac
fi

if [ "$CMD" = "text" ] || [ "$CMD" = "shell" ]; then
  shift 1 2>/dev/null || true
  A1="$*"
fi

if [ -x "$S/ld-musl-aarch64.so.1" ] && [ -f "$S/opencode" ]; then
  PC_CMD="$CMD" PC_A1="$A1" PC_A2="$A2" PC_A3="$A3" PC_A4="$A4" PC_A5="$A5" PC_TOK="$TOK" \
  BUN_BE_BUN=1 "$S/ld-musl-aarch64.so.1" --library-path "$S" "$S/opencode" -e '
const fs = require("node:fs");
const e = process.env;
const cmd = e.PC_CMD || "";
const tok = e.PC_TOK || "";
const a1 = e.PC_A1 || "";
const a2 = e.PC_A2 || "";
const a3 = e.PC_A3 || "";
const a4 = e.PC_A4 || "";
const a5 = e.PC_A5 || "";
const base = "http://127.0.0.1:4399";
const q = (k, v) => encodeURIComponent(k) + "=" + encodeURIComponent(v);

let route = "";
switch (cmd) {
  case "ping": route = "/ping"; break;
  case "shot": route = "/shot"; break;
  case "dump": route = "/dump"; break;
  case "tap": route = "/tap?" + q("x", a1) + "&" + q("y", a2); break;
  case "swipe": route = "/swipe?" + q("x1", a1) + "&" + q("y1", a2) + "&" + q("x2", a3) + "&" + q("y2", a4) + "&" + q("ms", a5 || "300"); break;
  case "text": route = "/text?" + q("t", a1); break;
  case "key": route = "/key?" + q("k", a1); break;
  case "open": route = "/open?" + q("p", a1); break;
  case "install": route = "/install?" + q("p", a1); break;
  case "shell": route = "/shell?" + q("c", a1); break;
  case "notify": route = "/notify?" + q("m", a1) + "&" + q("t", a2); break;
  case "list": route = "/list?" + q("f", a1); break;
  case "pair": route = "/pair?" + q("c", a1) + "&" + q("p", a2); break;
  case "control": route = "/control"; break;
  default:
    console.log("usage: pc ping|shot [png]|dump|tap x y|swipe x1 y1 x2 y2 [ms]|text txt|key k|open pkg|install apk|shell cmd|notify msg [title]|list [f]|pair code [port]|control");
    process.exit(cmd ? 1 : 0);
}

try {
  const sig = typeof AbortSignal !== "undefined" && AbortSignal.timeout ? AbortSignal.timeout(45000) : undefined;
  const res = await fetch(base + route, { headers: { "X-Bridge-Token": tok }, signal: sig });
  if (cmd === "shot") {
    if (!res.ok) {
      console.error(await res.text());
      process.exit(1);
    }
    const out = a1 || "shot.png";
    fs.writeFileSync(out, Buffer.from(await res.arrayBuffer()));
    console.log(out);
  } else {
    const txt = await res.text();
    process.stdout.write(txt.endsWith("\n") ? txt : txt + "\n");
    if (!res.ok) process.exit(1);
  }
} catch (err) {
  console.error("bridge error:", err && err.message ? err.message : String(err));
  process.exit(1);
}
'
  exit $?
fi

echo "pc error: OpenCode runtime not found under $S" >&2
exit 1
